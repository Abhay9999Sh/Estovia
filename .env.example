MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?appName=YourApp
MONGODB_DB=estovia

# Session signing secret - use a long random string in production
AUTH_SECRET=change_this_to_a_long_random_secret_string

# Development admin seed (optional overrides for `npm run seed:admin`).
# The seed is idempotent and non-destructive.
ADMIN_EMAIL=admin@estovia.in
ADMIN_PASSWORD=changeme123

# App
NEXT_PUBLIC_APP_NAME=Estovia
NEXT_PUBLIC_APP_TAGLINE=Find Land. Build Opportunities.

# OpenStreetMap
NEXT_PUBLIC_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Cloudinary (server-side uploads) - set in the Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional RERA verification API (per-State/UT RERA authority).
# Leave unset to keep RERA status as pending/manual_review (never auto-verified).
RERA_API_URL=
RERA_API_KEY=

# --- AI property valuation (ml-service) -------------------------------------
# See ml-service/README.md and ml-service/DATA_SOURCES.md.

# Directory holding the RUNTIME artefacts: model_builtup.bin,
# model_builtup.meta.json, registry.json and comparables.json. These are the
# files under src/lib/valuation/artifacts, NOT the training archive in
# ml-service/artifacts (which has no .bin and a stale conformal block).
# Leave this unset to use the built-in default, which resolves correctly under
# both `next dev` and a production build.
# ML_MODEL_DIR=src/lib/valuation/artifacts

# Version string recorded on every saved valuation. Bump when the feature
# transform or prediction path changes in a way that makes older results
# incomparable.
VALUATION_ENGINE_VERSION=valuation.v1

# Maximum valuation predictions per user per hour. Enforced by counting the
# caller's own saved valuations, so the limit holds across serverless
# instances. Set to 0 to disable.
VALUATION_RATE_LIMIT_PER_HOUR=30

# Whether to persist prediction results so they can be returned by
# /api/valuation/history. Set to false to disable history storage. When false,
# /api/valuation/history returns 404 and predictions are not archived.
VALUATION_STORE_PREDICTIONS=true

# Segment switches, reserved for when a model exists for those segments.
# They are NOT what drives today's refusals: the API decides what it can
# answer from the deployed artefact itself, and land and commercial have no
# model, so they return an explicit unsupported status. Turning these on
# without a trained model will still produce "no model for segment".
ML_ENABLE_LAND_SEGMENT=false
ML_ENABLE_COMMERCIAL_SEGMENT=false

# Geocoding / POI endpoints (no credentials, public usage policy applies).
# Placeholders - replace only with the endpoint you actually intend to use.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# Licensed provider API keys. These are placeholders for future ADAPTERS THAT
# ARE NOT IMPLEMENTED AND NOT USED. No adapter reads these variables, and no
# data has been retrieved from 99acres, MagicBricks or Housing.com. No public
# API was verified for any of them; obtaining access would require a provider
# API key under a written data-licensing agreement, or written permission.
ML_PROVIDER_API_KEY_99ACRES=
ML_PROVIDER_API_KEY_MAGICBRICKS=
ML_PROVIDER_API_KEY_HOUSINGCOM=
